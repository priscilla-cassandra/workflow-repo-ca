# Copy this file to .env and fill in your own values.
#
# Browser config (API_BASE_URL, API_KEY) is injected into js/env.js by
# `npm run env`, which runs automatically before `npm run dev`.

# Noroff API v2 base URL (no trailing slash)
API_BASE_URL=https://v2.api.noroff.dev

# Your Noroff API key. Leave blank until you have created one — see README.
# Generated after logging in via POST /auth/create-api-key.
API_KEY=

# Credentials used by the Playwright e2e login test (tests/e2e/login.spec.js)
TEST_USER_EMAIL=your_email@stud.noroff.no
TEST_USER_PASSWORD=your_password
