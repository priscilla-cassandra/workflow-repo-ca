{
  "name": "workflow-repo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "env": "node scripts/generate-env.mjs",
    "dev": "npm run env && concurrently -k -n css,server -c blue,green \"npm run dev:css\" \"npm run dev:serve\"",
    "dev:css": "npx tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "dev:serve": "live-server --port=3000 --open=/ --wait=300 --ignore=node_modules,test-results,playwright-report,.git,tests",
    "lint": "eslint",
    "format": "prettier . --write",
    "prepare": "husky install",
    "vitest": "vitest",
    "playwright": "npx playwright test --ui",
    "playwright:run": "npx playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@vitest/browser": "^4.1.6",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "live-server": "^1.2.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.12",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*html": [
      "prettier --write"
    ]
  }
}
